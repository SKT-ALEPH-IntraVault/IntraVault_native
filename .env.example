APP_NAME=IntraVault
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080
APP_LOCALE=ko
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=intravault_native
DB_USERNAME=intravault_native
DB_PASSWORD=replace-with-random-password

LAB_DB_USERNAME=intravault_native_reader
LAB_DB_PASSWORD=replace-with-reader-password
LAB_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

INTRAVAULT_BIND=127.0.0.1
INTRAVAULT_PORT=18080
TRUSTED_PROXIES=
